{
  "manifest_version": 3,
  "name": "课利译",
  "version": "1.1.2",
  "description": "全页面翻译、划词翻译与网页总结。兼容 OpenAI 协议，可自行填写 API Key 与 Base URL。",
  "homepage_url": "https://yanlaoxier.github.io/ai-translator-extension/",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "课利译",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "panel/panel.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/ui.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
